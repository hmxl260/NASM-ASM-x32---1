NASM ASM CLIPBOARD - 32 BIT
--------------------------
[BASIC START]

section .data

section .bss

section .text
	global _start:
_start
--------------------------
[FILLED START]

section .data
	msgx db "Prompt 1",0
	msgx_L equ $-msgx
section .bss
	var resb 260
section .text
	global _start:
_start
--------------------------
[BASIC REGISTER SIZES]

32-bit: EAX, EBX, ECX, EDX
16-bit: AX, BX, CX, DX
8-bit: AH/AL, BH/BL, CH/CL, DH/DL
--------------------------


--------------------------
[BASIC OUTP]

	mov eax, 4
	mov ebx, 1
	mov ecx, msgx
	mov edx, msgx_L
	int 0x80
--------------------------
[BASIC INP]

	mov eax, 3
	mov ebx, 0
	mov ecx, var
	mov edx, 260
	int 0x80
--------------------------
[BASIC EXIT]

	mov eax, 1
	mov ebx, 0
	int 0x80
--------------------------


--------------------------
[BASIC STACK FRAME]
	push ebp
	mov ebp, esp

	mov esp, ebp
	pop ebp
	ret
--------------------------
[COMPARE]

	mov eax, DWORD [x]
	mov ebx, DWORD [y]
	cmp eax, ebx ;compare first

	cmp al, 'X'

--------------------------
[JUMPS]

	jmp label	;jump to label
	je label	;jump to label if Equal
	jne label	;jump to label if Not Equal
	jz label	;jump to lavel if Zero
	jg label	;jump to lavel if Greater than
	jl label	;jump to label if Lesser than

	ja label	;jump to label if above
	jb label	;jump to label if below

	jo labael	;jump to label if overflow
	jno laval 	;jump to label if not overflow
--------------------------
